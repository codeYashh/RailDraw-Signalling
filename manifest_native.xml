<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.raildraw.app"
    android:versionCode="8"
    android:versionName="1.6.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- Network permissions for Play Store-style in-app OTA update checks & APK download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission to trigger system PackageInstaller directly after in-app download -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Voice input permission (Microphone) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Queries declaration for Speech Recognition package visibility on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RailDraw">

        <activity
            android:name="in.gov.railnet.raildraw.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.RailDraw">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pure-framework ContentProvider for streaming downloaded APK to Android PackageInstaller -->
        <provider
            android:name="in.gov.railnet.raildraw.ApkFileProvider"
            android:authorities="com.raildraw.app.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
